# Public and optional server configuration. Copy to .env.local and set values for your Supabase project.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
# Never put a secret/service-role key in a NEXT_PUBLIC_ variable.
# SUPABASE_SECRET_KEY is used only by fixture scripts and the isolated delivery worker.

# Optional external notification worker (all empty means external channels disabled).
SUPABASE_SECRET_KEY=
ROOMIEHUB_JOB_SECRET=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
RESEND_API_KEY=
ROOMIEHUB_EMAIL_FROM=
# Generate local VAPID pair + job token: node scripts/prepare-notification-keys.mjs
# Set VAPID_SUBJECT to a real production https: URL or mailto: contact URI.
